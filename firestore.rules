rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /products/{productId} {
      allow read: if resource.data.available != false || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    // Admin records must be created manually by the project owner in Firebase Console.
    // Clients cannot grant themselves admin access.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }
    match /sales/{saleId} {
      allow read, write: if isAdmin();
    }
    match /repairs/{repairId} {
      allow read, write: if isAdmin();
    }
    match /warranties/{warrantyId} {
      allow read, write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}